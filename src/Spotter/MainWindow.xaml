<ui:FluentWindow x:Class="Spotter.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Spotter"
                 xmlns:loc="clr-namespace:Spotter.Localization"
                 Title="Spotter"
                 Icon="pack://application:,,,/spotter.ico"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FlowDirection="{loc:LangProp FlowDirection}"
                 PreviewKeyDown="OnWindowKeyDown">

    <!-- No Width, Height, MinWidth or MinHeight, and no WindowStartupLocation. All five depend on
         how big the screen is, so they are worked out at startup by WindowLayout and applied from
         the constructor. Every size below is therefore a size at 100%: the root grid carries the
         shared UiScale.Transform as its LayoutTransform, so one number moves the whole window —
         text, padding, icons, row heights and the title bar together.

         Every piece of text here comes through {loc:Loc Key}, which resolves to a binding rather
         than a string, so changing language in Options updates this window in place instead of
         waiting for it to be reopened.

         FlowDirection above mirrors the whole window for Hebrew. WPF mirrors the layout coordinate
         system, so margins, alignments and DockPanel.Dock all follow with no help. Two things it
         also mirrors that it must not, and both are handled below: Image content — which would
         flip every file icon — and text that is machine data rather than language, where a
         right-to-left paragraph direction reorders a path or a size into nonsense. -->

    <!-- Right-clicking something should offer what you can do to *that* thing. Four menus, one
         per kind of target: a query field, the filter row, a result row, and the empty space
         below the results. The last two used to be one menu, so right-clicking the background
         offered Delete and Properties for whatever happened to still be selected. -->
    <ui:FluentWindow.Resources>

        <local:NegateConverter x:Key="Negate" />

        <!-- The stock GridView scroll template puts the column headers inside the scrolling
             area, so the vertical scrollbar runs the full height of the list and its track
             starts up level with the headers. Here the headers get their own row above the
             scrollbar, which is where every file manager puts them; the headers are slid
             sideways by the horizontal offset so they still follow the columns. -->
        <ControlTemplate x:Key="ResultsScrollViewerTemplate" TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" ClipToBounds="True">
                    <GridViewHeaderRowPresenter
                        Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                        ColumnHeaderContainerStyle="{Binding View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource AncestorType=ListView}}"
                        ColumnHeaderTemplate="{Binding View.ColumnHeaderTemplate, RelativeSource={RelativeSource AncestorType=ListView}}"
                        AllowsColumnReorder="{Binding View.AllowsColumnReorder, RelativeSource={RelativeSource AncestorType=ListView}}"
                        ColumnHeaderContextMenu="{Binding View.ColumnHeaderContextMenu, RelativeSource={RelativeSource AncestorType=ListView}}"
                        ColumnHeaderToolTip="{Binding View.ColumnHeaderToolTip, RelativeSource={RelativeSource AncestorType=ListView}}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <GridViewHeaderRowPresenter.RenderTransform>
                            <TranslateTransform
                                X="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Negate}}" />
                        </GridViewHeaderRowPresenter.RenderTransform>
                    </GridViewHeaderRowPresenter>
                </Border>

                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        Grid.Row="1" Grid.Column="0"
                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                        CanHorizontallyScroll="False"
                                        CanVerticallyScroll="False"
                                        KeyboardNavigation.DirectionalNavigation="Local" />

                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1"
                           Orientation="Vertical"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Grid.Column="0"
                           Orientation="Horizontal"
                           Maximum="{TemplateBinding ScrollableWidth}"
                           ViewportSize="{TemplateBinding ViewportWidth}"
                           Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>

        <ContextMenu x:Key="QueryBoxMenu" Opened="OnQueryMenuOpened">
            <!-- Modifier combinations stay as they are in every language: Ctrl+C is what is
                 printed on the key, not a word. The gestures that *are* words go through Loc. -->
            <MenuItem Header="{loc:Loc Menu.Cut}" InputGestureText="Ctrl+X"
                      Command="ApplicationCommands.Cut"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Loc Menu.Copy}" InputGestureText="Ctrl+C"
                      Command="ApplicationCommands.Copy"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Loc Menu.Paste}" InputGestureText="Ctrl+V"
                      Command="ApplicationCommands.Paste"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem x:Name="PasteAndSearchItem" Header="{loc:Loc Menu.PasteAndSearch}"
                      Click="OnPasteAndSearch"
                      ToolTip="{loc:Loc Menu.PasteAndSearch.Tip}" />
            <MenuItem Header="{loc:Loc Menu.RecentSearches}" Click="OnShowHistory"
                      InputGestureText="{loc:Loc Key.Down}" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.ClearField}" Click="OnClearThisField"
                      InputGestureText="Esc" />
            <MenuItem Header="{loc:Loc Menu.ClearAllFields}" Click="OnClearAllFields"
                      InputGestureText="{loc:Loc Key.EscEsc}" />
        </ContextMenu>

        <!-- Case and regex belong to a field, not to the search as a whole — that is how the
             engine stores them and how the 1.5.1 app presented them. -->
        <ContextMenu x:Key="NameOptionsMenu" Opened="OnNameOptionsOpened">
            <MenuItem x:Name="NameMatchCase" Header="{loc:Loc Menu.MatchCase}" IsCheckable="True"
                      Click="OnNameOptionToggled" />
            <MenuItem x:Name="NameRegex" Header="{loc:Loc Menu.Regex}" IsCheckable="True"
                      Click="OnNameOptionToggled"
                      ToolTip="{loc:Loc Menu.Regex.Name.Tip}" />
            <Separator />
            <MenuItem x:Name="NameFlexible" Header="{loc:Loc Menu.FlexibleSeparators}"
                      IsCheckable="True" Click="OnNameOptionToggled"
                      ToolTip="{loc:Loc Menu.FlexibleSeparators.Tip}" />
        </ContextMenu>

        <ContextMenu x:Key="FolderOptionsMenu" Opened="OnFolderOptionsOpened">
            <MenuItem x:Name="FolderMatchCase" Header="{loc:Loc Menu.MatchCase}" IsCheckable="True"
                      Click="OnFolderOptionToggled" />
            <MenuItem x:Name="FolderRegex" Header="{loc:Loc Menu.Regex}" IsCheckable="True"
                      Click="OnFolderOptionToggled"
                      ToolTip="{loc:Loc Menu.Regex.Folder.Tip}" />
            <Separator />
            <MenuItem x:Name="FolderSubfolders" Header="{loc:Loc Menu.Subfolders}" IsCheckable="True"
                      Click="OnFolderOptionToggled"
                      ToolTip="{loc:Loc Menu.Subfolders.Tip}" />
        </ContextMenu>

        <!-- The Tags are written in the grammar the engine actually parses, so each one is also a
             worked example of what can be typed by hand. They are expressions, not prose, and are
             the same in every language — the engine's own parser reads "To" and "MB". -->
        <ContextMenu x:Key="SizePresetMenu">
            <MenuItem Header="{loc:Loc Menu.Size.Empty}" Tag="= 0 B" Click="OnSizePreset" />
            <MenuItem Header="{loc:Loc Menu.Size.Tiny}" Tag="&lt; 10 KB" Click="OnSizePreset" />
            <MenuItem Header="{loc:Loc Menu.Size.Under1MB}" Tag="&lt; 1 MB" Click="OnSizePreset" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.Size.Over10MB}" Tag="&gt; 10 MB" Click="OnSizePreset" />
            <MenuItem Header="{loc:Loc Menu.Size.Over100MB}" Tag="&gt; 100 MB" Click="OnSizePreset" />
            <MenuItem Header="{loc:Loc Menu.Size.Over1GB}" Tag="&gt; 1 GB" Click="OnSizePreset" />
            <MenuItem Header="{loc:Loc Menu.Size.Over10GB}" Tag="&gt; 10 GB" Click="OnSizePreset" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.Size.Between}" Tag="100 MB To 1 GB" Click="OnSizePreset" />
            <MenuItem Header="{loc:Loc Menu.Size.About700MB}" Tag="~700 MB" Click="OnSizePreset" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.Size.Clear}" Tag="" Click="OnSizePreset" />
        </ContextMenu>

        <ContextMenu x:Key="FilterMenu" Opened="OnFilterMenuOpened">
            <MenuItem x:Name="MenuBoth" Header="{loc:Loc Menu.Filter.Both}" IsCheckable="True"
                      Click="OnFilterKindChosen" />
            <MenuItem x:Name="MenuFilesOnly" Header="{loc:Loc Menu.Filter.FilesOnly}" IsCheckable="True"
                      Click="OnFilterKindChosen" />
            <MenuItem x:Name="MenuFoldersOnly" Header="{loc:Loc Menu.Filter.FoldersOnly}" IsCheckable="True"
                      Click="OnFilterKindChosen" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.Filter.Reset}" Click="OnResetFilters"
                      ToolTip="{loc:Loc Menu.Filter.Reset.Tip}" />
        </ContextMenu>

        <ContextMenu x:Key="ResultsMenu">
            <MenuItem Header="{loc:Loc Menu.Open}" InputGestureText="Enter" Click="OnOpen" />
            <MenuItem Header="{loc:Loc Menu.OpenFolder}" Click="OnOpenFolder" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.CopyPath}" InputGestureText="Ctrl+C" Click="OnCopyFullPath" />
            <MenuItem Header="{loc:Loc Menu.CopyName}" Click="OnCopyName" />
            <MenuItem Header="{loc:Loc Menu.CopyFolder}" Click="OnCopyFolder" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.ExportSelected}" InputGestureText="Ctrl+S" Click="OnExportSelected" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.Delete}" InputGestureText="Del" Click="OnDelete" />
            <MenuItem Header="{loc:Loc Menu.DeletePermanently}" InputGestureText="Shift+Del"
                      Click="OnDeletePermanently" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.Properties}" InputGestureText="Alt+Enter" Click="OnProperties" />
        </ContextMenu>

        <!-- Nothing was clicked, so nothing file-specific is offered. -->
        <ContextMenu x:Key="BackgroundMenu">
            <MenuItem Header="{loc:Loc Menu.SelectAll}" InputGestureText="Ctrl+A" Click="OnSelectAll" />
            <MenuItem Header="{loc:Loc Menu.ClearSelection}" Click="OnClearSelection" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.ExportAll}" Click="OnExportAll" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.SearchAgain}" InputGestureText="F5" Click="OnSearchAgain" />
            <MenuItem Header="{loc:Loc Menu.ClearAllFields}" Click="OnClearAllFields" />
            <Separator />
            <!-- The one place in the window that is about the app rather than about a file or a
                 field, which is why a second window is offered from here. -->
            <MenuItem Header="{loc:Loc Menu.NewInstance}" InputGestureText="Ctrl+N"
                      Click="OnNewInstance" />
        </ContextMenu>

        <ContextMenu x:Key="HeaderMenu" Opened="OnHeaderMenuOpened">
            <!-- Both headers are rewritten in OnHeaderMenuOpened to name the column that was
                 clicked, so the text set here is only what shows when there is no column behind
                 the pointer. -->
            <MenuItem x:Name="HeaderSortAscending" Header="{loc:Loc Menu.SortAscending}" Click="OnHeaderSort" />
            <MenuItem x:Name="HeaderSortDescending" Header="{loc:Loc Menu.SortDescending}" Click="OnHeaderSort" />
            <Separator />
            <MenuItem Header="{loc:Loc Menu.FitColumn}" Click="OnFitColumn" />
            <MenuItem Header="{loc:Loc Menu.ResetColumns}" Click="OnResetColumnWidths" />
        </ContextMenu>

        <!-- Result cells.

             The grid mirrors with the rest of the window, so in Hebrew the Name column is on the
             right, as it is in Explorer. What does NOT mirror is the content: a path, a size, a
             date and an extension are machine data, and a right-to-left paragraph direction
             reorders them — a path ending in a separator jumps its trailing "\" to the far end,
             and bidi mirrors the brackets in a name like "[2024] report". So these stay
             LeftToRight internally and are aligned to the leading edge of the column instead, which
             puts them where the header is without touching how they read.

             The file name is the exception, because it is the one column whose content really is
             language: FileItem.NameDirection picks a direction from the name's own first strong
             character, so "notepad.exe" reads left to right and a Hebrew name reads right to
             left, in the same list. -->
        <DataTemplate x:Key="NameCell">
            <!-- A DockPanel, not a StackPanel. A horizontal StackPanel measures its children with
                 unlimited width, so the TextBlock below always believed it had room and its
                 CharacterEllipsis never fired: a name too long for the column was cut off
                 mid-letter by the cell's clip instead of ending in an ellipsis. Docking the icon
                 and letting the text fill the rest gives it a real width to trim against. -->
            <DockPanel LastChildFill="True"
                       ToolTip="{Binding Contents}"
                       ToolTipService.IsEnabled="{Binding IsDirectory}">
                <!-- Never mirrored. WPF flips Image content under RightToLeft, and a mirrored
                     file-type icon is simply a broken icon.

                     16 is the size at 100%; the scale transform on the root grid takes it from
                     there, and ShellIcons asks the shell for a bitmap with enough pixels in it to
                     survive that. HighQuality is what makes a 32-pixel icon shown at 22 look like
                     an icon rather than a smudge. -->
                <!-- Dock="Left" is logical, so under RightToLeft WPF mirrors it and the icon stays
                     on the leading edge, ahead of the name, in Hebrew too. -->
                <Image DockPanel.Dock="Left"
                       Source="{Binding Icon}" Width="16" Height="16"
                       FlowDirection="LeftToRight"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,8,0" SnapsToDevicePixels="True" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           FlowDirection="{Binding NameDirection}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="PathCell">
            <TextBlock Text="{Binding Directory}" FlowDirection="LeftToRight"
                       TextAlignment="{loc:LangProp StartAlignment}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="SizeCell">
            <TextBlock Text="{Binding SizeText}" FlowDirection="LeftToRight"
                       TextAlignment="{loc:LangProp StartAlignment}" />
        </DataTemplate>

        <DataTemplate x:Key="ModifiedCell">
            <TextBlock Text="{Binding Modified, StringFormat=g}" FlowDirection="LeftToRight"
                       TextAlignment="{loc:LangProp StartAlignment}" />
        </DataTemplate>

        <DataTemplate x:Key="TypeCell">
            <TextBlock Text="{Binding Extension}" FlowDirection="LeftToRight"
                       TextAlignment="{loc:LangProp StartAlignment}" />
        </DataTemplate>

        <DataTemplate x:Key="CreatedCell">
            <TextBlock Text="{Binding Created, StringFormat=g}" FlowDirection="LeftToRight"
                       TextAlignment="{loc:LangProp StartAlignment}" />
        </DataTemplate>

        <DataTemplate x:Key="AccessedCell">
            <TextBlock Text="{Binding Accessed, StringFormat=g}" FlowDirection="LeftToRight"
                       TextAlignment="{loc:LangProp StartAlignment}" />
        </DataTemplate>

        <!-- How tall the three query boxes are. The theme's own padding is drawn for a dialog
             field that is read once; these three are the window's working surface, sit directly
             above the results, and every vertical pixel they give back is a row of results.

             One value in one place because the three have to agree to the pixel — they share a
             row, and the buttons beside them have no height of their own: a DockPanel stretches a
             docked child to the panel's height, so the boxes set the height of the row and
             everything in it follows. Changing this number is therefore the whole adjustment.

             X is deliberately the theme's own 10: the caret should not sit against the border,
             and the field's icon needs room. Y is the axis with slack in it.

             Every button in the row therefore carries VerticalAlignment="Stretch" instead of a
             height of its own. A DockPanel does stretch a docked child, but the button style
             centres it, and a style's alignment only loses to one set on the element — which is
             why they measured 17 px against a 28 px field until it was set here. -->
        <Thickness x:Key="QueryFieldPadding" Left="10" Top="3" Right="10" Bottom="3" />

        <!-- A caption button, drawn to match the three the theme provides.
             
             Neither stock control does. A ui:Button is a toolbar button: rounded corners, its
             own padding, and a pill-shaped highlight that beside three square ones reads as a
             mistake. A ui:TitleBarButton is the right control but draws its glyph from its
             ButtonType, and the only type with no window command behind it — Unknown — has no
             glyph either, so it came out invisible.
             
             Hence the template, and its numbers are measured off the real buttons rather than
             guessed: 44 x 30, anchored to the TOP of the bar, which is where Windows 11 puts
             caption buttons and where this theme puts these. A button of the bar's full height,
             centred, sat its glyph 1.6 px below the other three — the kind of difference that
             is invisible to describe and obvious to look at. Square, and the theme's own two
             subtle fills for hover and pressed, which are the brushes the real ones use. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The chevron that opens the file types panel, beside the Files switch.
             A ui:Button is the wrong shape for this: even in its Transparent appearance it draws
             a border and carries a control's own padding, which measured 20.8 units tall against
             the switch's 20 and sat 0.8 higher — close enough to look like a mistake rather than
             a difference. This is the switch's own height, borderless, and shows nothing but the
             glyph until the pointer is over it. -->
        <Style x:Key="ChevronButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- Focusable, unlike the caption buttons this template is modelled on. Those are
                 window commands with keyboard routes of their own; this is a search option, and
                 leaving it out of the tab order would make it the only one in the row that
                 cannot be reached without a mouse. -->
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <!-- Everything in the window hangs off this one element, which is what makes a single
         LayoutTransform on it enough to resize the entire interface. -->
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Icon was explicitly nulled here, which is why the app showed one in the taskbar but
             nowhere inside its own chrome. -->
        <!-- The icon is named because the window's message hook needs its rectangle: it reports
             itself to Windows as the system-menu button, so that one click opens the system menu
             and two close the window. See "the system-menu icon" in MainWindow.xaml.cs for why
             that cannot be a mouse handler here. -->
        <!-- 32 rather than the theme's 48. A title bar holds a name and three buttons, and
             Windows itself draws that in 32; the 16 pixels above the search fields were the
             single largest piece of nothing in the window. 32 is also where the bar stops
             leaving a dead strip beneath the caption buttons, which are 30 tall and anchored
             to its top. -->
        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="Spotter" Height="32">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleIcon"
                              Source="pack://application:,,,/spotter.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
            <!-- A second window, next to minimize and close. TrailingContent is the slot just
                 inside the caption buttons, so it mirrors with them: left of them in English,
                 right of them in Hebrew, without being told.

                 Drawn as a caption button rather than as a toolbar button — transparent, no
                 border, full height of the bar — because that is what it sits among, and it is
                 not focusable for the same reason the real ones are not. The taskbar's own
                 gesture for this cannot be answered (see App.ShiftHeldAtLaunch), so the window
                 offers it where a window can. -->
            <ui:TitleBar.TrailingContent>
                <Button Style="{StaticResource CaptionButton}" Click="OnNewInstance"
                        ToolTip="{loc:Loc NewInstance.Tip}">
                    <ui:SymbolIcon Symbol="Add24" FontSize="14" />
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Query -->
        <!-- No top margin: the title bar above already ends in its own space, and the two
             together read as a gap rather than as a margin. -->
        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <!-- The name field gives a quarter of its width to the size field. Shares are
                     not what the fields look like: each column also carries its buttons at a
                     fixed width, and the size field pays for its presets button out of the
                     smallest column, which left its placeholder — an example of the grammar,
                     and the only documentation of it on screen — cut off mid-word. -->
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,0" VerticalAlignment="Stretch"
                           Icon="{ui:SymbolIcon Options24}" Tag="NameOptionsMenu"
                           Click="OnFieldOptions"
                           ToolTip="{loc:Loc Field.Name.OptionsTip}" />
                <!-- Re-runs the query that is already typed, which is the only way to notice a
                     file that has appeared since the last run: the same OnSearchAgain that F5 and
                     the context menu call. It is beside the box because waiting for a file to be
                     written means pressing it over and over, and the gesture people reached for
                     instead was typing a letter and deleting it again.

                     Docked Left — the start of the field, so the opposite end from the options
                     button, and under the Hebrew FlowDirection that start is the right-hand side.
                     Focusable="False" keeps the caret and the selection in the box across a
                     click, so typing can carry on straight after a refresh.

                     Disabled while all three fields are blank, which is the state in which a
                     search returns nothing by definition (SearchQuery.IsEmpty), so there would be
                     nothing to re-run. Kept in step by UpdateRefreshButton. -->
                <ui:Button x:Name="RefreshButton" DockPanel.Dock="Left" Margin="0,0,4,0"
                           Padding="8,0" VerticalAlignment="Stretch" IsEnabled="False"
                           Icon="{ui:SymbolIcon ArrowSync24}" Focusable="False"
                           Click="OnSearchAgain"
                           ToolTip="{loc:Loc Field.Name.RefreshTip}" />
            <ui:TextBox x:Name="FilenameBox"
                        Padding="{StaticResource QueryFieldPadding}"
                        MinHeight="0"
                        PlaceholderText="{loc:Loc Field.Name.Placeholder}"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        FontSize="15"
                        TextChanged="OnQueryChanged"
                        PreviewKeyDown="OnQueryBoxKeyDown"
                        LostKeyboardFocus="OnQueryBoxLostFocus"
                        ContextMenu="{StaticResource QueryBoxMenu}">
                <ui:TextBox.ToolTip>
                    <StackPanel MaxWidth="360">
                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Field.Name.Tip.Title}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="{loc:Loc Field.Name.Tip.Part}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:Loc Field.Name.Tip.Words}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="{loc:Loc Field.Name.Tip.Wildcards}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"
                                   Text="{loc:Loc Field.Name.Tip.Keys}" />
                    </StackPanel>
                </ui:TextBox.ToolTip>
            </ui:TextBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,0" VerticalAlignment="Stretch"
                           Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowseFolder"
                           ToolTip="{loc:Loc Field.Folder.BrowseTip}" />
                <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,0" VerticalAlignment="Stretch"
                           Icon="{ui:SymbolIcon Options24}" Tag="FolderOptionsMenu"
                           Click="OnFieldOptions"
                           ToolTip="{loc:Loc Field.Folder.OptionsTip}" />
            <ui:TextBox x:Name="DirectoryBox"
                        Padding="{StaticResource QueryFieldPadding}"
                        MinHeight="0"
                        PlaceholderText="{loc:Loc Field.Folder.Placeholder}"
                        Icon="{ui:SymbolIcon Folder24}"
                        ClearButtonEnabled="True"
                        AllowDrop="True"
                        PreviewDragOver="OnFolderDragOver"
                        PreviewDrop="OnFolderDrop"
                        TextChanged="OnQueryChanged"
                        PreviewKeyDown="OnQueryBoxKeyDown"
                        ContextMenu="{StaticResource QueryBoxMenu}">
                <ui:TextBox.ToolTip>
                    <StackPanel MaxWidth="360">
                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Field.Folder.Tip.Title}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="{loc:Loc Field.Folder.Tip.Part}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:Loc Field.Folder.Tip.Levels}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"
                                   Text="{loc:Loc Field.Folder.Tip.Subfolders}" />
                    </StackPanel>
                </ui:TextBox.ToolTip>
            </ui:TextBox>
            </DockPanel>

            <DockPanel Grid.Column="4">
                <ui:Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,0" VerticalAlignment="Stretch"
                           Icon="{ui:SymbolIcon ChevronDown24}" Tag="SizePresetMenu"
                           Click="OnFieldOptions"
                           ToolTip="{loc:Loc Field.Size.PresetsTip}" />
            <!-- The one query field that is left-to-right in every language, because what goes in
                 it is an expression in the engine's grammar rather than words: "> 100 MB". Under a
                 right-to-left paragraph direction the bidi algorithm gives that ">" the
                 paragraph's direction and mirrors it, so someone typing "greater than" would watch
                 it appear as "less than" — the opposite filter. Marks in the string cannot fix it;
                 a European number counts as right-to-left when the punctuation beside it is
                 resolved. Only the base direction can, so it is set here. -->
            <ui:TextBox x:Name="SizeBox"
                        Padding="{StaticResource QueryFieldPadding}"
                        MinHeight="0"
                        PlaceholderText="{loc:Loc Field.Size.Placeholder}"
                        Icon="{ui:SymbolIcon Ruler24}"
                        ClearButtonEnabled="True"
                        FlowDirection="LeftToRight"
                        TextAlignment="{loc:LangProp StartAlignment}"
                        TextChanged="OnQueryChanged"
                        PreviewKeyDown="OnQueryBoxKeyDown"
                        ContextMenu="{StaticResource QueryBoxMenu}">
                <ui:TextBox.ToolTip>
                    <StackPanel MaxWidth="330">
                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Field.Size.Tip.Title}" />

                        <!-- Each line is "expression — what it means", and each half needs a
                             different direction.

                             The line itself follows the UI, so in Hebrew the expression is on the
                             right and is therefore the first thing read — which is the point of the
                             line. Getting this wrong is subtle rather than obviously broken: laying
                             the whole line out left-to-right also renders every character correctly,
                             but puts the meaning before the expression for a Hebrew reader, i.e.
                             backwards.

                             The expression Run is pinned LeftToRight so that its operator survives.
                             A ">" in a right-to-left run is *mirrored* by the bidi algorithm, and
                             this tooltip is where someone goes to learn what ">" does — showing them
                             "<" would teach the opposite filter.

                             The expressions are the engine's own grammar and identical in every
                             language, so they are literals here rather than translated strings; only
                             the meanings come from the tables. -->
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"><Run FlowDirection="LeftToRight" Text="&gt; 50 MB" /><Run Text="  —  " /><Run Text="{loc:Loc Field.Size.Tip.Gt}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FlowDirection="LeftToRight" Text="&lt;= 100 KB" /><Run Text="  —  " /><Run Text="{loc:Loc Field.Size.Tip.Le}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FlowDirection="LeftToRight" Text="= 1 MB" /><Run Text="  —  " /><Run Text="{loc:Loc Field.Size.Tip.Eq}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FlowDirection="LeftToRight" Text="~1 GB" /><Run Text="  —  " /><Run Text="{loc:Loc Field.Size.Tip.About}" /></TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FlowDirection="LeftToRight" Text="200 MB To 300 MB" /><Run Text="  —  " /><Run Text="{loc:Loc Field.Size.Tip.Range}" /></TextBlock>

                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"
                                   Text="{loc:Loc Field.Size.Tip.Units}" />
                    </StackPanel>
                </ui:TextBox.ToolTip>
            </ui:TextBox>
            </DockPanel>

            <!-- Recent searches. A Popup rather than an AutoSuggestBox: suggestions that filter
                 as you type would fight the search box itself, where every keystroke is already
                 a query. This only opens when asked for. -->
            <Popup x:Name="HistoryPopup" Grid.Column="0"
                   PlacementTarget="{Binding ElementName=FilenameBox}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   PopupAnimation="Fade">
                <!-- A Popup is its own visual root, outside the window's tree, so it inherits
                     neither the window's FlowDirection nor its scale and has to be given both.
                     The width is set here rather than on the Popup for the same reason: the box's
                     ActualWidth is measured inside the transform, so it only matches what is on
                     screen once this Border has been scaled by the same amount. -->
                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                        FlowDirection="{loc:LangProp FlowDirection}"
                        LayoutTransform="{x:Static local:UiScale.Transform}"
                        Width="{Binding ActualWidth, ElementName=FilenameBox}"
                        Padding="4">
                    <StackPanel>
                        <TextBlock x:Name="HistoryEmpty"
                                   Text="{loc:Loc History.Empty}"
                                   TextWrapping="Wrap" Opacity="0.7" Margin="8,6,8,6"
                                   Visibility="Collapsed" />
                        <ListBox x:Name="HistoryList" MaxHeight="280"
                                 Background="Transparent" BorderThickness="0"
                                 PreviewKeyDown="OnHistoryKeyDown"
                                 PreviewMouseLeftButtonUp="OnHistoryClicked" />
                        <Separator Margin="4,4,4,2" />
                        <TextBlock Text="{loc:Loc History.Hint}"
                                   Opacity="0.6" FontSize="11" Margin="8,0,8,4" />
                        <ui:Button x:Name="ClearHistoryButton" Content="{loc:Loc History.Clear}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Padding="8,4" Click="OnClearHistory" />
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Folder completion, which the 1.5.1 box got from the shell's
                 AutoCompleteSource.FileSystemDirectories. Typing a path here means typing it
                 exactly right, and there is no reason to make anyone do that. -->
            <Popup x:Name="FolderPopup" Grid.Column="2"
                   PlacementTarget="{Binding ElementName=DirectoryBox}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                        FlowDirection="{loc:LangProp FlowDirection}"
                        LayoutTransform="{x:Static local:UiScale.Transform}"
                        Width="{Binding ActualWidth, ElementName=DirectoryBox}"
                        Padding="4">
                    <!-- The entries are absolute paths, so they are read left to right whatever
                         the UI language is — see the result cells above for the same reasoning. -->
                    <ListBox x:Name="FolderSuggestions" MaxHeight="260"
                             Background="Transparent" BorderThickness="0"
                             FlowDirection="LeftToRight"
                             PreviewKeyDown="OnFolderSuggestKeyDown"
                             PreviewMouseLeftButtonUp="OnFolderSuggestClicked" />
                </Border>
            </Popup>
        </Grid>

        <!-- Options -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,0"
                    VerticalAlignment="Bottom" Visibility="Collapsed" />

        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                        Background="Transparent"
                        ContextMenu="{StaticResource FilterMenu}">
                <!-- Content is assigned from code rather than bound, because it carries the
                     number of file types in effect — "Files (3)". A filter that removes results
                     has to be visible on the surface that caused it; a count only inside the
                     panel would mean a search quietly missing half its answers with nothing on
                     screen to say why. UpdateFileTypesUi owns the text, including after a
                     language change. -->
                <ui:ToggleSwitch x:Name="FilesToggle" IsChecked="True"
                                 Margin="0,0,2,0" Checked="OnQueryChanged" Unchecked="OnQueryChanged"
                                 ToolTip="{loc:Loc Toolbar.Files.Tip}" />
                <Button x:Name="FileTypesButton" Style="{StaticResource ChevronButton}"
                        Margin="0,0,16,0" Click="OnFileTypes">
                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" />
                </Button>
                <ui:ToggleSwitch x:Name="FoldersToggle" Content="{loc:Loc Toolbar.Folders}" IsChecked="True"
                                 Margin="0,0,24,0" Checked="OnQueryChanged" Unchecked="OnQueryChanged"
                                 ToolTip="{loc:Loc Toolbar.Folders.Tip}" />
                <!-- Case, regex and subfolders live on the fields they modify, behind each
                     field's options button. This row is only about what kind of thing to find. -->
                <TextBlock x:Name="ActiveOptionsText" VerticalAlignment="Center" Opacity="0.65"
                           ToolTip="{loc:Loc Toolbar.ActiveOptions.Tip}" />
            </StackPanel>

            <!-- The file types panel. A Popup rather than a ContextMenu, which is what the field
                 options buttons use: this one ends in a text box, and typing inside a menu fights
                 the menu's own key handling — a menu swallows the space bar and closes on a
                 letter it takes for an access key.

                 The rows themselves are built in code from FileKinds.All, so adding a kind means
                 adding it to the enum and its label to the tables, not here. -->
            <Popup x:Name="FileTypesPopup" Grid.Row="0"
                   PlacementTarget="{Binding ElementName=FileTypesButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   PopupAnimation="Fade" Closed="OnFileTypesClosed"
                   Focusable="False" PreviewKeyDown="OnFileTypesKeyDown">
                <!-- Its own visual root, so neither the direction nor the scale is inherited and
                     both are set here. See HistoryPopup for the long version. -->
                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                        FlowDirection="{loc:LangProp FlowDirection}"
                        LayoutTransform="{x:Static local:UiScale.Transform}"
                        MinWidth="240" Padding="10,8,10,8">
                    <StackPanel>
                        <TextBlock x:Name="FileTypesHeading" FontWeight="SemiBold"
                                   Text="{loc:Loc Types.Title}" Margin="0,0,0,6" />

                        <!-- Shown indeterminate when some are on, which is the state the eight
                             rows below can put it in. It replaces the mirror of the outer Files
                             switch that this panel could have had: the switch outside already
                             turns files off altogether, and a second control doing the same thing
                             one level down would be two ways to say one thing. -->
                        <!-- Height and padding to match the rows below, which BuildFileTypesList
                             sets for the same reason: the theme's 32 units for 18 of text is a
                             form control's spacing, not a list's. -->
                        <CheckBox x:Name="AllTypesBox" Content="{loc:Loc Types.All}"
                                  MinHeight="0" Padding="11,2,11,2" Margin="0,1,0,1"
                                  IsThreeState="False" Click="OnAllTypesClicked" />
                        <Separator Margin="0,4,0,4" />
                        <StackPanel x:Name="FileTypesList" />

                        <Separator Margin="0,4,0,4" />
                        <TextBlock Text="{loc:Loc Types.Custom}" Opacity="0.8" Margin="0,0,0,3" />
                        <!-- Left to right whatever the language is, like the size box: what goes
                             in it is a list of extensions, not words. -->
                        <ui:TextBox x:Name="TypeExtensionsBox"
                                    Padding="8,2" MinHeight="0"
                                    FlowDirection="LeftToRight"
                                    TextAlignment="{loc:LangProp StartAlignment}"
                                    PlaceholderText="{loc:Loc Types.Custom.Placeholder}"
                                    ClearButtonEnabled="True"
                                    TextChanged="OnTypeExtensionsChanged" />
                        <TextBlock Text="{loc:Loc Types.Custom.Hint}" TextWrapping="Wrap"
                                   MaxWidth="240" Opacity="0.6" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Popup>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,0,8">
                <!-- Only shown when "search as you type" is off, exactly as the 1.5.1 app showed
                     its Start/Stop button. Its Content is set from code, which is also what
                     switches it to Stop, so it carries no Loc binding here. -->
                <ui:Button x:Name="SearchButton" Appearance="Primary"
                           Icon="{ui:SymbolIcon Search24}"
                           Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed"
                           Click="OnSearchButton"
                           ToolTip="{loc:Loc Toolbar.Search.Tip}" />
                <ui:Button x:Name="HistoryButton"
                           Icon="{ui:SymbolIcon History24}" Content="{loc:Loc Toolbar.Recent}"
                           ToolTip="{loc:Loc Toolbar.Recent.Tip}"
                           Padding="10,4" Margin="0,0,8,0" Click="OnShowHistory" />
                <ui:Button Icon="{ui:SymbolIcon Settings24}" Content="{loc:Loc Toolbar.Options}"
                           Padding="10,4" Click="OnOptions"
                           ToolTip="{loc:Loc Toolbar.Options.Tip}" />
            </StackPanel>

            <!-- A plain ListView keeps its stock white chrome regardless of the Fluent theme,
                 so the surfaces are bound to theme brushes explicitly. -->
            <ListView x:Name="ResultsList" Grid.Row="1"
                      SelectionMode="Extended"
                      Background="{DynamicResource ControlFillColorDefaultBrush}"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                      BorderThickness="1"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      MouseDoubleClick="OnResultActivated"
                      PreviewMouseLeftButtonDown="OnResultsMouseDown"
                      PreviewMouseRightButtonDown="OnResultsRightButtonDown"
                      ContextMenuOpening="OnResultsContextMenuOpening"
                      PreviewMouseWheel="OnResultsMouseWheel"
                      MouseMove="OnResultsMouseMove">
                <ListView.Resources>
                    <!-- The key the ListView template looks up for its scroll viewer when the
                         view is a GridView. -->
                    <Style x:Key="{x:Static GridView.GridViewScrollViewerStyleKey}"
                           TargetType="ScrollViewer">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template"
                                Value="{StaticResource ResultsScrollViewerTemplate}" />
                    </Style>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="10,7" />
                        <!-- Logical, not physical: WPF mirrors alignment under RightToLeft, so
                             this is the leading edge in both directions. -->
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="ContextMenu" Value="{StaticResource HeaderMenu}" />
                        <Setter Property="ToolTip" Value="{loc:Loc Column.Tip}" />
                        <EventSetter Event="Click" Handler="OnColumnHeaderClick" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Grid>
                                    <Border x:Name="HeaderCell"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True" />
                                    </Border>
                                    <!-- GridViewColumnHeader implements dragging to resize by
                                         looking for a Thumb with exactly this name. Replacing
                                         the stock template without it is what removed column
                                         resizing; double-clicking it still auto-fits, as
                                         everywhere else. Right/-5 are mirrored by WPF under
                                         RightToLeft, so the gripper stays on the column's
                                         trailing edge in Hebrew too. -->
                                    <Thumb x:Name="PART_HeaderGripper"
                                           HorizontalAlignment="Right"
                                           Width="9" Margin="0,0,-5,0"
                                           Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent" Width="9" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderCell" Property="Background"
                                                    Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="HeaderCell" Property="Background"
                                                    Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- The stock ListViewItem template hardcodes light hover and selection
                         chrome that ignores the Fluent theme, so the row is templated from
                         scratch against theme brushes. -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Row"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Margin="2,1"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <GridViewRowPresenter
                                            Content="{TemplateBinding Content}"
                                            Columns="{TemplateBinding GridView.ColumnCollection}"
                                            SnapsToDevicePixels="True" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Trigger>
                                        <!-- Selected but the list no longer has focus: keep the
                                             row readable instead of shouting in accent colour. -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Deleted rows stay put, struck through and dimmed, so a file that
                                 disappeared after the search is visibly gone rather than merely
                                 absent from a list you might have scrolled past. -->
                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorDisabledBrush}" />
                                <Setter Property="TextBlock.TextDecorations" Value="Strikethrough" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <!-- local:ColumnKey.Value is the sort key and the translation key, and it is
                         what makes both survive translation: the header text is now "שם ▼" in
                         Hebrew, so reading the header back as an identifier — which is what this
                         used to do — would look up a comparison that does not exist and silently
                         stop sorting. -->
                    <!-- Name, Path, Size and Modified add up to just under the width of the window
                         WindowLayout opens by default, so the four columns anyone actually reads
                         are there without scrolling sideways for them. The three after that are
                         off the right edge until the window is widened, which is the trade a
                         window that opens in a quarter of the screen has to make somewhere.
                         Widths here are at 100%; the scale transform moves them with the rest. -->
                    <GridView>
                        <GridViewColumn local:ColumnKey.Value="Name" Width="290"
                                        CellTemplate="{StaticResource NameCell}" />
                        <GridViewColumn local:ColumnKey.Value="Path" Width="370"
                                        CellTemplate="{StaticResource PathCell}" />
                        <GridViewColumn local:ColumnKey.Value="Size" Width="95"
                                        CellTemplate="{StaticResource SizeCell}" />
                        <GridViewColumn local:ColumnKey.Value="Modified" Width="145"
                                        CellTemplate="{StaticResource ModifiedCell}" />
                        <GridViewColumn local:ColumnKey.Value="Type" Width="70"
                                        CellTemplate="{StaticResource TypeCell}" />
                        <GridViewColumn local:ColumnKey.Value="Created" Width="150"
                                        CellTemplate="{StaticResource CreatedCell}" />
                        <GridViewColumn local:ColumnKey.Value="Accessed" Width="150"
                                        CellTemplate="{StaticResource AccessedCell}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Padding="16,8" Margin="0,8,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing x:Name="BusyRing" IsIndeterminate="True"
                                     Width="16" Height="16" Margin="0,0,10,0" />
                    <!-- Determinate while the drives are read, because that is the one wait in
                         this app long enough that "how much longer?" is a fair question. Its
                         tooltip breaks the total down per drive. -->
                    <ProgressBar x:Name="IndexBar" Width="150" Height="6"
                                 Minimum="0" Maximum="1" Value="0"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 Visibility="Collapsed"
                                 ToolTipService.InitialShowDelay="200"
                                 ToolTipService.ShowDuration="30000" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Text="{loc:Loc Status.Starting}" />
                    <ui:Button x:Name="ElevateButton" Content="{loc:Loc Status.Elevate}"
                               Appearance="Primary" Margin="14,0,0,0" Padding="10,3"
                               Visibility="Collapsed" Click="OnElevate"
                               ToolTip="{loc:Loc Status.Elevate.Tip}" />
                </StackPanel>
                <TextBlock x:Name="SelectionText" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Opacity="0.7"
                           ToolTip="{loc:Loc Status.Selected.Tip}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
