<Application x:Class="Spotter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Overwritten at startup to follow the Windows app mode. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Tooltips and context menus need the reading direction set too, and it is emphatically
                 NOT done here — see PopupChrome.cs. An implicit Style with a
                 FlowDirection setter looks like the natural place for it and quietly replaces
                 WPF-UI's theming with stock light-grey WPF chrome. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
