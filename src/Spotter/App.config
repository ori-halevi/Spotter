<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System.Configuration.ConfigurationManager">
      <section name="Spotter.Utils.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" requirePermission="false" />
    </sectionGroup>
  </configSections>

  <applicationSettings>
    <!-- The 2014 engine's own logger, which is a different thing from Spotter.log.
         It defaults to ON and records every USN journal event on every volume - i.e. the name of
         every file created, deleted or renamed anywhere on the machine - to a plain text file
         next to the executable. One session produced a 2.99 MB log plus three rotated zips.

         That is a privacy problem, needless disk I/O on the indexing path, and a write into the
         install directory that fails outright under Program Files. Off by default; set
         LogEnabled to True and point LogFilePath somewhere writable when diagnosing the engine. -->
    <Spotter.Utils.Settings>
      <setting name="LogEnabled" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="DetailedLog" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="LogFilePath" serializeAs="String">
        <value>Spotter.Engine.log</value>
      </setting>
    </Spotter.Utils.Settings>
  </applicationSettings>
</configuration>
